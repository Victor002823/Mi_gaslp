<ScrollView
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:padding="16dp"
android:background="@color/purple_dark">

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="vertical">

<!-- Campo Fecha con calendario -->
<com.google.android.material.textfield.TextInputLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:hint="Fecha (dd/mm/yyyy)"
app:endIconMode="custom"
app:endIconDrawable="@android:drawable/ic_menu_my_calendar"
app:hintTextColor="@color/white"
app:boxBackgroundMode="filled"
app:boxBackgroundColor="@color/purple_card"
app:boxCornerRadiusTopStart="8dp"
app:boxCornerRadiusTopEnd="8dp"
app:boxCornerRadiusBottomStart="8dp"
app:boxCornerRadiusBottomEnd="8dp">

<com.google.android.material.textfield.TextInputEditText
android:id="@+id/edtFecha"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:textColor="@color/white"
android:focusable="false"/>
</com.google.android.material.textfield.TextInputLayout>

<!-- Campo Cantidad -->
<com.google.android.material.textfield.TextInputLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:hint="Cantidad (L)"
android:layout_marginTop="12dp"
app:hintTextColor="@color/white"
app:boxBackgroundMode="filled"
app:boxBackgroundColor="@color/purple_card"
app:boxCornerRadiusTopStart="8dp"
app:boxCornerRadiusTopEnd="8dp"
app:boxCornerRadiusBottomStart="8dp"
app:boxCornerRadiusBottomEnd="8dp">

<com.google.android.material.textfield.TextInputEditText
android:id="@+id/edtCantidad"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:inputType="numberDecimal"
android:textColor="@color/white"/>
</com.google.android.material.textfield.TextInputLayout>

<!-- Campo Notas -->
<com.google.android.material.textfield.TextInputLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:hint="Notas"
android:layout_marginTop="12dp"
app:hintTextColor="@color/white"
app:boxBackgroundMode="filled"
app:boxBackgroundColor="@color/purple_card"
app:boxCornerRadiusTopStart="8dp"
app:boxCornerRadiusTopEnd="8dp"
app:boxCornerRadiusBottomStart="8dp"
app:boxCornerRadiusBottomEnd="8dp">

<com.google.android.material.textfield.TextInputEditText
android:id="@+id/edtNotas"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:textColor="@color/white"/>
</com.google.android.material.textfield.TextInputLayout>

<!-- Botón Guardar -->
<Button
android:id="@+id/btnGuardar"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:text="Guardar"
android:layout_marginTop="20dp"
android:backgroundTint="@color/purple_light"
android:textColor="@color/purple_dark"/>

<!-- Botón Borrar -->
<Button
android:id="@+id/btnBorrar"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:text="Borrar"
android:layout_marginTop="10dp"
android:backgroundTint="@color/red_alert"
android:textColor="@color/white"
android:visibility="gone"/>
</LinearLayout>
</ScrollView>